MEITUAN_AGENT_ENV=dev

MEITUAN_AGENT_DATA_DIR=backend/data
MEITUAN_AGENT_MEMORY_BACKEND=sqlite
MEITUAN_AGENT_SQLITE_PATH=backend/data/memory.sqlite3

MEITUAN_AGENT_LLM_PROVIDER=none
MEITUAN_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
MEITUAN_AGENT_OPENAI_API_KEY=
MEITUAN_AGENT_OPENAI_MODEL=gpt-4o-mini

MEITUAN_AGENT_ASR_PROVIDER=none
MEITUAN_AGENT_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEITUAN_AGENT_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_API_KEY=

# 地图数据源：auto | osm | amap | mock
# auto: 有高德 Key 时走高德，否则自动走 OpenStreetMap
MEITUAN_AGENT_MAP_PROVIDER=auto

# 高德地图真实 API 配置（可选）
# 申请地址：https://console.amap.com/dev/key/app
MEITUAN_AGENT_AMAP_API_KEY=

# OpenStreetMap 真实数据配置（默认即可，无需商业认证）
MEITUAN_AGENT_OSM_USER_AGENT=meituan-competition-agent/1.0
MEITUAN_AGENT_OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
MEITUAN_AGENT_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
MEITUAN_AGENT_OSM_OSRM_URL=https://router.project-osrm.org

MEITUAN_AGENT_MAX_QUEUE_MINUTES=60

